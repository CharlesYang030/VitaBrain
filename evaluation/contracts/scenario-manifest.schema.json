{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://egophys.local/contracts/scenario-manifest.schema.json",
  "title": "Immutable Scenario Manifest",
  "type": "object",
  "required": ["scenario_id", "version", "digest", "channel", "supported_verbs", "evaluator_version", "handoff_contracts"],
  "properties": {
    "scenario_id": {"type": "string"},
    "version": {"type": "string"},
    "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "channel": {"enum": ["development", "frozen"]},
    "supported_seeds": {"type": "array", "items": {"type": "integer"}, "minItems": 1},
    "supported_verbs": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "evaluator_version": {"type": "string"},
    "capability_annotations": {"type": "array", "items": {"type": "object"}},
    "handoff_contracts": {"type": "array", "items": {"type": "object"}}
  },
  "additionalProperties": true
}

